{
    "interface_version": 2,
    "name": "mihua",
    "label": "物华弥新小助手",
    "title": "物华弥新 MAA",
    "icon": "resource/image/logo.png",
    "version": "0.1.0",
    "license": "GPL-3.0",
    "description": "物华弥新（`com.cipaishe.laigu`）的 MaaFramework 项目。\n\n- 画布按 720p 构建（`display_short_side: 720`），模板图取自 1280×720 实机截图，roi 与模板一一对应。\n- 任务分三组：`日常` 只做导航与识别，`派遣公司` 三条链路会改动派遣阵容、制造类还会消耗游戏内材料，`通用` 是器者征集、仓库这类独立动作。\n- 抽卡、招集、购买活力、花灰珀或券类道具，一律不在任何任务、选项或预设里。\n- 截至 0.1.0，全部节点只做过静态校验（模板齐备、引用无悬空、roi 装得下模板），尚未在实机跑过整条链路。",
    "welcome": [
        "当前为物华弥新MAA的测试版本"
    ],
    "agent": {
        "child_exec": ".venv/Scripts/python.exe",
        "child_args": [
            "./agent/warehouse_agent.py"
        ]
    },
    "controller": [
        {
            "name": "安卓端",
            "label": "模拟器",
            "type": "Adb",
            "display_short_side": 720
        },
        {
            "name": "桌面端",
            "label": "PC 客户端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "物华弥新|来古弥新",
                "screencap": "PrintWindow",
                "mouse": "SendMessageWithCursorPos",
                "keyboard": "SendMessage"
            }
        }
    ],
    "resource": [
        {
            "name": "官服",
            "label": "官服",
            "path": [
                "./resource"
            ],
            "controller": [
                "安卓端",
                "桌面端"
            ]
        }
    ],
    "group": [
        {
            "name": "日常",
            "label": "日常（不动资源）",
            "description": "只做导航与识别：开面板、认页签、回大厅。不点任何玩法入口，不点领取以外的按钮。",
            "default_expand": true
        },
        {
            "name": "派遣公司",
            "label": "派遣公司",
            "description": "三条派遣链路。入驻会按好感度换下已满的器者并补位；道具制造与社会指南制造还会消耗游戏内制造材料。",
            "default_expand": true
        },
        {
            "name": "通用",
            "label": "通用工具",
            "description": "与具体玩法无关的辅助动作，常被预设排在第一位。",
            "default_expand": true
        },
        {
            "name": "作战",
            "label": "作战（会消耗活力值）",
            "description": "均衡刷取：按仓库识别结果自动决定刷冬谷币 / 教材 / 核定牌。默认活力不足即停止，不购买、不等待；只有显式选「购买活力值」才会点购买入口。抽卡、征集、商亭一律不在本组内。",
            "default_expand": true
        }
    ],
    "task": [
        {
            "name": "Mail",
            "label": "邮件领取",
            "controller": [
                "安卓端"
            ],
            "entry": "Mail",
            "default_check": true,
            "group": [
                "日常"
            ],
            "description": "领取邮件"
        },
        {
            "name": "Dispatch.InRoom",
            "label": "派遣公司·入驻器者",
            "controller": [
                "安卓端"
            ],
            "entry": "派遣.派遣公司进入入口",
            "default_check": false,
            "group": [
                "派遣公司"
            ]
        },
        {
            "name": "Dispatch.Craft",
            "label": "派遣公司·道具制造",
            "controller": [
                "安卓端"
            ],
            "entry": "派遣.制造进入入口",
            "default_check": false,
            "group": [
                "派遣公司"
            ],
            "option": [
                "道具种类"
            ]
        },
        {
            "name": "Dispatch.Guide",
            "label": "派遣公司·社会指南制造",
            "controller": [
                "安卓端"
            ],
            "entry": "派遣.指南进入入口",
            "default_check": false,
            "group": [
                "派遣公司"
            ],
            "option": [
                "指南种类"
            ]
        },
        {
            "name": "器者征集",
            "label": "器者征集",
            "controller": [
                "安卓端"
            ],
            "entry": "征集.进入入口",
            "default_check": false,
            "group": [
                "通用"
            ],
            "description": "进器者征集 → 选征集次数 → 确认 → 跳过动画 → 返回大厅。"
        },
        {
            "name": "奖励领取",
            "label": "奖励领取",
            "controller": [
                "安卓端"
            ],
            "entry": "奖励.领取入口",
            "default_check": false,
            "group": [
                "日常"
            ],
            "description": "领取日常/周常奖励"
        },
        {
            "name": "仓库识别",
            "label": "仓库识别",
            "controller": [
                "安卓端"
            ],
            "entry": "仓库进入",
            "default_check": false,
            "group": [
                "通用"
            ],
            "description": "./report/仓库快照.md"
        },
        {
            "name": "游历奖励领取",
            "label": "游历奖励领取",
            "controller": [
                "安卓端"
            ],
            "entry": "游历奖励进入",
            "default_check": false,
            "group": [
                "日常"
            ],
            "description": "主页 → 游历 → 任务 → 全部领取 → 点空白处 → 反复直到按钮消失 → 挑战 → 全部领取 → 点空白处 → 反复直到按钮消失 → 返回大厅。只点领取，不买等级、不解锁瑞牒。"
        },
        {
            "name": "作战刷取",
            "label": "作战刷取（均衡材料）",
            "controller": [
                "安卓端"
            ],
            "entry": "作战.进入入口",
            "default_check": false,
            "group": [
                "作战"
            ],
            "option": [
                "刷取方式",
                "关卡类别",
                "关卡等级",
                "核定牌职业",
                "刷取轮数",
                "活力值用尽怎么办",
                "购买活力值次数"
            ]
        }
    ],
    "option": {
        "指南种类": {
            "type": "select",
            "label": "社会指南选择",
            "default_case": "进阶",
            "cases": [
