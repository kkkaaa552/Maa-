        "活力值用尽怎么办": {
            "type": "select",
            "label": "活力值用尽怎么办",
            "default_case": "直接停止",
            "cases": [
                {
                    "name": "直接停止",
                    "label": "直接停止（不花资源）",
                    "pipeline_override": {
                        "作战.活力决策": {
                            "next": [
                                "作战.停止"
                            ]
                        }
                    }
                },
                {
                    "name": "等待恢复",
                    "label": "等待恢复（不花资源）",
                    "pipeline_override": {
                        "作战.活力决策": {
