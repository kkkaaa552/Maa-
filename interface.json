                    "name": "均衡刷取",
                    "label": "均衡刷取（按仓库补缺，补完按 冬谷币→教材→核定牌 轮换）",
                    "pipeline_override": {
                        "作战.均衡决策": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "op": "decide",
                                        "mode": "balance",
                                        "level": "",
                                        "profession": ""
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "name": "手动指定",
                    "label": "手动指定（用下面的类别/等级/职业）",
                    "pipeline_override": {
                        "作战.均衡决策": {
                            "action": {
                                "param": {
                                    "custom_action_param": {
                                        "op": "decide",
                                        "mode": "manual",
                                        "level": "",
                                        "profession": ""
                                    }
