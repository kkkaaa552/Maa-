        "活力值用尽怎么办": {
            "type": "select",
            "label": "活力值用尽怎么办",
            "description": "刷到一半活力不足时的动作。默认「直接停止」——不花任何资源。选「购买活力值」才会点购买入口（消耗灰珀/道具）；选「等待恢复」原地等 60 秒重试，最多 5 次，不花钱。",
            "default_case": "直接停止",
            "cases": [
                {
                    "name": "直接停止",
                    "label": "直接停止（不花资源）",
                    "description": "识别到活力不足提示就结束本任务并回大厅。",
                    "pipeline_override": {
                        "作战.活力决策": {
                            "next": [
                                "作战.停止"
                            ]
                        }
                    }
                },
                {
                    "name": "等待恢复",
                    "label": "等待恢复（不花资源）",
                    "description": "原地等 60 秒再试一次速通，最多 5 次。",
                    "pipeline_override": {
                        "作战.活力决策": {
                            "next": [
                                "作战.等待恢复"
                            ]
