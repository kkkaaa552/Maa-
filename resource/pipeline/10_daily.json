{
    "$schema": "https://raw.githubusercontent.com/MaaXYZ/MaaFramework/main/schema/pipeline.schema.json",

    "Daily": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": [
            "Daily.OpenEntry",
            "Daily.OpenEntryTpl"
        ]
    },

    "Daily.OpenEntry": {
        "recognition": "OCR",
        "roi": [
            1120,
            630,
            150,
            70
        ],
        "expected": "任务",
        "action": "Click",
        "target": true,
        "post_delay": 1200,
        "timeout": 6000,
        "next": [
            "Daily.PanelReady"
        ],
        "on_error": [
            "Daily.Leave"
        ]
    },

    "Daily.OpenEntryTpl": {
        "recognition": "TemplateMatch",
        "roi": [
            1040,
            600,
            240,
            120
        ],
        "template": "任务.png",
        "threshold": 0.85,
        "action": "Click",
        "target": true,
        "post_delay": 1200,
        "timeout": 6000,
        "next": [
            "Daily.PanelReady"
        ],
        "on_error": [
            "Daily.Leave"
        ]
    },

    "Daily.PanelReady": {
        "recognition": "OCR",
        "roi": [
            0,
            0,
            330,
            80
        ],
        "expected": "日常",
        "action": "DoNothing",
        "timeout": 8000,
        "next": [
            "Daily.Leave"
        ],
        "on_error": [
            "Daily.Leave"
        ]
    },

    "Daily.Leave": {
        "recognition": "TemplateMatch",
        "roi": [
            0,
            0,
            220,
            120
        ],
        "template": "返回.png",
        "threshold": 0.9,
        "action": "Click",
        "target": true,
        "post_delay": 1200,
        "timeout": 5000,
        "next": [
            "ReturnHall"
        ],
        "on_error": [
            "Daily.Leave.Force"
        ]
    },

    "Daily.Leave.Force": {
        "recognition": "DirectHit",
        "action": "Click",
        "target": [
            48,
            38
        ],
        "post_delay": 1200,
        "max_hit": 8,
        "next": [
            "ReturnHall"
        ]
    }
}
