{
    "$schema": "https://raw.githubusercontent.com/MaaXYZ/MaaFramework/main/schema/pipeline.schema.json",
    "迷踪盘": {
        "desc": "入口驱动节点。轮询「棋盘页 → 大厅 → 派遣公司 → 茶室 → 关卡选择」五级页面（棋盘页放最前，先把上一轮中断遗留的对局退出来），当前在哪一级就做那一步；next 顺序即优先级，关卡页放最前，已经进了就不再乱点。末尾「点空白」是兜底：气泡浮窗挡住页面时先点一下空地关掉再重试。on_error 统一走 迷踪盘.收尾，保证任何一环失败都能退回大厅而不是卡死。",
        "recognition": {
            "type": "DirectHit",
            "param": {
                "roi": [
                    0,
                    0,
                    0,
                    0
                ]
            }
        },
        "pre_delay": 500,
        "timeout": 45000,
        "next": [
            "迷踪盘.弹窗",
            "迷踪盘.回退",
            "迷踪盘.关卡页",
            "迷踪盘.点迷",
            "迷踪盘.点店",
            "迷踪盘.去派遣",
            "迷踪盘.点空白"
        ],
        "on_error": [
            "迷踪盘.收尾"
        ]
    },
    "迷踪盘.回退": {
        "desc": "入口回退：上一轮被中途打断时画面会停在棋盘页，此时入口的四个导航候选（关卡页/点迷/点店/去派遣）全部不命中，会直接落到「点空白」兜底 —— 在棋盘页点空地没有任何作用，连点 4 次打满 max_hit 就掉进收尾，整轮一关没刷却报成功（2026-11-26 15:28 实测实例）。本节点用 迷踪盘.棋盘.png（130x110，裁自棋盘页左下缩略盘）认棋盘页，命中后点左上返回箭头 (40,15,40,40) 退回关卡页，next 回入口重新判页面，后续就能正常走 关卡页 → 连刷。注意 action 写死 target=[40,15,40,40] 而**不是** target:true —— 棋盘页点棋盘中心等于落一子，会白耗移动次数（第 30 关上限只有 1 次）。",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    440,
                    540,
                    130,
                    110
                ],
                "template": [
                    "迷踪盘.棋盘.png"
                ],
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    40,
                    15,
                    40,
                    40
                ]
            }
        },
        "post_delay": 1600,
        "timeout": 10000,
        "max_hit": 3,
        "next": [
            "迷踪盘"
        ],
        "on_error": [
            "迷踪盘.收尾"
        ]
    },
    "迷踪盘.去派遣": {
        "desc": "第 1 步：大厅右下「派遣公司」入口。用 派遣公司.png（105x138）而不是 OCR——与项目里 派遣.派遣公司入口 同口径，模板比 OCR 稳。roi 1050,390,230,190 装得下模板；点击 target:true 跟随命中位置。",
