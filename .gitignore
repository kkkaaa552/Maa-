/tools/win_ocr.ps1

# ---- 开发期标注与验收产物 ----
# data/digits/_report.txt 是 build_digits.py 的输出报告；
# data/warehouse/ 下的 sheet_*.png、tolabel_*.png、ticket.json 是
# wh_sheet.py / wh_tolabel.py --out 手工生成的对照图，代码里 0 引用。
data/digits/_report.txt
data/warehouse/sheet_*.png
data/warehouse/tolabel_*.png
data/warehouse/ticket.json

# 库存快照是「上一次扫描结果」（本机跑完才有），build.py:41 明确不打包。
# 仓库里留一份只会让它和别人的实际库存对不上。
data/warehouse/物料.json
data/warehouse/票券.json
data/warehouse/资源.json

