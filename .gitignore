# ---- 开发期探针与手工工具（不进仓库，也不进发布包）----
# tools/ 整个目录会被 build.py 打进发布包（build.py:507），这些脚本既不在
# 运行期 import 可达集（唯一例外 mtboard.py 必须留），也不在 CI 构建链上，
# 摆进仓库只会让使用者以为要读它们。
/tools/_mt_*.py
/tools/burst.py
/tools/mt_drop_orphans.py
/tools/mt_patch_board.py
/tools/mt_patch_entry.py
/tools/mt_tpl_board.py
